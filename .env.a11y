# =================================
# A11y Platform Environment Variables
# =================================

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_NAME=a11y_platform
DATABASE_URL=postgresql://admin:admin@localhost:5432/a11y_platform

# Redis Configuration (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# S3/MinIO Storage Configuration
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=a11y-artifacts
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=1h

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Configuration (for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Accessibility Scanning Configuration
SCAN_TIMEOUT=30000
SCAN_VIEWPORT_WIDTH=1280
SCAN_VIEWPORT_HEIGHT=720
MAX_CONCURRENT_SCANS=5
MAX_CRAWL_DEPTH=3
SCAN_USER_AGENT=A11y-Platform-Scanner/1.0

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-change-in-production
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRIES=3

# External Audit Logging (Retraced)
RETRACED_URL=
RETRACED_API_KEY=
RETRACED_PROJECT_ID=

# External Webhook Service (Svix)
SVIX_API_KEY=

# Service URLs
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Team Features
TEAM_FEATURES_AUDIT_LOG=true
TEAM_FEATURES_WEBHOOK=true